# Database
DATABASE_URL=postgres://fairmove:fairmove_password@localhost:5432/fairmove

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=fairmove_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1d

REFRESH_TOKEN_SECRET=fairmove_refresh_token_secret_key_change_in_production
