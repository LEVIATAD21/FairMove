# ============================================================
# FairMove Backend — variáveis de ambiente
# Copie para `.env` e preencha cada placeholder.
# ============================================================

# --- Database -------------------------------------------------
# Substitua a senha por uma de alta entropia (ou use o docker-compose).
POSTGRES_PASSWORD=CHANGE_ME_HIGH_ENTROPY_PASSWORD
DATABASE_URL=postgres://fairmove:CHANGE_ME_HIGH_ENTROPY_PASSWORD@localhost:5432/fairmove

# --- Redis (opcional; sem REDIS_URL o realtime fica no-op) -----
# O Redis do compose roda com requirepass — a senha precisa estar na URL.
REDIS_PASSWORD=CHANGE_ME_HIGH_ENTROPY_REDIS_PASSWORD
REDIS_URL=redis://localhost:6379

# --- JWT ------------------------------------------------------
# Política de segredos (validado no boot com fail-fast):
#   mínimo 32 chars em qualquer ambiente, mínimo 64 em produção,
#   REFRESH_TOKEN_SECRET diferente de JWT_SECRET.
# Gere os dois com:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_64_CHARS_MIN_GENERATED_WITH_OPENSSL_RAND
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=CHANGE_ME_A_DIFFERENT_64_CHARS_MIN_SECRET
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Application ----------------------------------------------
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000
# Só ligue quando houver proxy reverso real (nginx/LB) na frente.
# Sem proxy, "1"/"true" deixa X-Forwarded-For forjável e derruba o rate limit.
TRUST_PROXY=false

# --- Plataforma -----------------------------------------------
# Carteira "donos da plataforma" (usuário seed/admin financeiro).
PLATFORM_USER_ID=CHANGE_ME_PLATFORM_ADMIN_USER_ID

# --- Recuperação de senha -------------------------------------
# DEVE ficar ausente/false em produção: expõe o token de reset na resposta.
# EXPOSE_RESET_TOKEN=true

# --- Providers (Mock no MVP) ----------------------------------
MOCK_PAYMENT_PROVIDER_URL=http://localhost:3000
MOCK_MAPS_PROVIDER_URL=http://localhost:3000
MOCK_NOTIFICATION_PROVIDER_URL=http://localhost:3000
