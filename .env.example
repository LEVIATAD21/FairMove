# ============================================================
# FairMove Backend — variáveis de ambiente
# Copie para `.env` e preencha cada placeholder.
#
# PRODUÇÃO: todas as credenciais vêm de variáveis de ambiente
# seguras (secret manager / cofre) — nunca de código ou repo.
# Gere cada segredo novo com:  openssl rand -base64 48
# ============================================================

# --- Database (produção) -------------------------------------
# Substitua a senha por uma de alta entropia (ou use o docker-compose em dev).
POSTGRES_PASSWORD=CHANGE_ME_HIGH_ENTROPY_PASSWORD
DATABASE_URL=postgres://fairmove_user:CHANGE_ME_STRONG_PASSWORD@db.fairmove.com.br:5432/fairmove_prod
# Dev local (docker compose): postgres://fairmove:CHANGE_ME_HIGH_ENTROPY_PASSWORD@localhost:5432/fairmove

# --- Redis (produção; sem REDIS_URL o realtime fica no-op) ---
# O Redis do compose roda com requirepass — a senha precisa estar na URL.
REDIS_PASSWORD=CHANGE_ME_HIGH_ENTROPY_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis.fairmove.com.br:6379
# Dev local: redis://localhost:6379

# --- JWT ------------------------------------------------------
# Política de segredos (validado no boot com fail-fast):
#   mínimo 32 chars em qualquer ambiente, mínimo 64 em produção,
#   REFRESH_TOKEN_SECRET diferente de JWT_SECRET.
# Gere os DOIS com valores DIFERENTES:  openssl rand -base64 48
JWT_SECRET=GERAR_VIA_OPENSSL_RAND_BASE64_48
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=GERAR_VIA_OPENSSL_RAND_BASE64_48_DIFERENTE_DO_ANTERIOR
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Application ----------------------------------------------
# development local | production em produção (afeta fail-fast de JWT, caches etc.)
NODE_ENV=development
PORT=3000
# Origem permitida: http://localhost:3000 (dev) | https://api.fairmove.com.br (prod)
CORS_ORIGIN=http://localhost:3000
# Só ligue quando houver proxy reverso real (nginx/LB) na frente.
# Sem proxy, "1"/"true" deixa X-Forwarded-For forjável e derruba o rate limit.
TRUST_PROXY=false

# --- Domínio público ------------------------------------------
# Usado em links/canônicos quando há proxy reverso ou túnel (ngrok/Railway).
PUBLIC_API_URL=https://api.fairmove.com.br

# --- Plataforma -----------------------------------------------
# Carteira "donos da plataforma" (usuário seed/admin financeiro).
PLATFORM_USER_ID=CHANGE_ME_PLATFORM_ADMIN_USER_ID

# --- Billing automático (BUG-C) -------------------------------
# Job diário 02:00 cobra as mensalidades vencidas (chargeMonthlyFee).
# Ligue SOMENTE em produção — dev/teste não devem cobrar.
BILLING_ENABLED=false

# --- Admin inicial (primeiro acesso) --------------------------
# Só para provisionar a primeira conta admin via API.
# REMOVA estas variáveis do .env após criar a conta em produção.
INITIAL_ADMIN_EMAIL=admin@fairmove.com.br
INITIAL_ADMIN_PASSWORD=GERAR_SENHA_FORTE_COM_OPENSSL_RAND

# --- Seed / E2E operacional -----------------------------------
# Contas criadas por `pnpm db:seed-driver` (também lidas pelo e2e:ride/demo).
# Mantenha em .env.local (gitignored) se preferir separar do .env de runtime.
# Gere cada uma com:  openssl rand -base64 16
SEED_DRIVER_PASSWORD=CHANGE_ME_SEED_DRIVER_PASSWORD
SEED_ADMIN_PASSWORD=CHANGE_ME_SEED_ADMIN_PASSWORD
SEED_PASSENGER_PASSWORD=CHANGE_ME_SEED_PASSENGER_PASSWORD

# --- Recuperação de senha -------------------------------------
# DEVE ficar ausente/false em produção: expõe o token de reset na resposta.
# EXPOSE_RESET_TOKEN=true

# --- Verificação de e-mail ------------------------------------
# true = registro cria conta SEM token de login até confirmar o código de 6
# dígitos (login bloqueia com 403 até verify-email). Requer provedor de e-mail
# (packages/auth: TODO SMTP/Mailgun/SES) — sem ele, use EXPOSE_VERIFICATION_CODE
# em desenvolvimento. Contas anteriores à ativação devem ser backfilleadas:
#   UPDATE users SET email_verified_at = now() WHERE email_verified_at IS NULL;
REQUIRE_EMAIL_VERIFICATION=false
# EXPOSE_VERIFICATION_CODE=true

# --- Providers (Mock no MVP) ----------------------------------
MOCK_PAYMENT_PROVIDER_URL=http://localhost:3000
MOCK_MAPS_PROVIDER_URL=http://localhost:3000
MOCK_NOTIFICATION_PROVIDER_URL=http://localhost:3000
