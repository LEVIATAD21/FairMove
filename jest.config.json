{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "rootDir": ".",
  "testMatch": [
    "<rootDir>/tests/**/*.test.ts"
  ],
  "transform": {
    "^.+\\.[t]sx?$": "ts-jest"
  },
  "moduleFileExtensions": ["ts", "js", "json"],
  "moduleNameMapper": {
    "^@fairmove/shared-db$": "<rootDir>/packages/shared-db/src/index"
  }
}
