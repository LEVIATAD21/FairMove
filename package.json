{
  "name": "FairMove",
  "version": "1.0.0",
  "description": "Brazilian mobility platform - FairMove",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/backend/src/index.js",
    "app:passenger": "pnpm --filter passenger start",
    "app:driver": "pnpm --filter driver start",
    "test": "jest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.0",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "ioredis": "^6.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.9.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fairmove/config": "workspace:*",
    "@fairmove/shared-db": "workspace:*",
    "@fairmove/shared-types": "workspace:*",
    "@fairmove/ui": "workspace:*",
    "@fairmove/validation": "workspace:*",
    "@types/cron": "^2.4.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.23.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  }
}
