{
  "name": "FairMove",
  "version": "1.0.0",
  "description": "Brazilian mobility platform - FairMove",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/backend/src/index.js",
    "app:passenger": "pnpm --filter passenger start",
    "app:driver": "pnpm --filter driver start",
    "test": "jest -w 2 --testTimeout=60000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed-driver": "node dist/scripts/seed-driver.js",
    "e2e:ride": "bash scripts/e2e-ride.sh",
    "demo:e2e": "node dist/scripts/demo-e2e.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "babel-preset-expo": "^57.0.13",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "ioredis": "^6.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "supertest": "^7.3.0",
    "test-renderer": "^1.3.0",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.9.5",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fairmove/config": "workspace:*",
    "@fairmove/shared-db": "workspace:*",
    "@fairmove/shared-types": "workspace:*",
    "@fairmove/ui": "workspace:*",
    "@fairmove/validation": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/cron": "^2.4.3",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "cron": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "pg": "^8.23.0",
    "uuid": "^11.1.1",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  }
}
