{
  "expo": {
    "name": "FairMove Passageiro",
    "slug": "fairmove-passenger",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "fairmove",
    "splash": {
      "backgroundColor": "#050505",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fairmove.passenger"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.fairmove.passenger"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O FairMove usa sua localização para definir o ponto de partida da corrida."
        }
      ]
    ],
    "extra": {
      "port": 8099
    }
  }
}
