{
  "expo": {
    "name": "FairMove Motorista",
    "slug": "fairmove-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "fairmove-driver",
    "splash": {
      "backgroundColor": "#050505",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fairmove.driver"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.fairmove.driver"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "port": 8100
    }
  }
}
