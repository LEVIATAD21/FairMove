{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@fairmove/shared-db": ["packages/shared-db/src/index"],
      "@fairmove/shared-types": ["packages/shared-types/src/index"],
      "@fairmove/design-system": ["packages/design-system/src/index"],
      "@fairmove/validation": ["packages/validation/src/index"],
      "@fairmove/config": ["packages/config/src/index"]
    }
  },
  "include": ["packages/**/src", "backend/src"],
  "exclude": ["node_modules", "dist", "**/*.d.ts"]
}
